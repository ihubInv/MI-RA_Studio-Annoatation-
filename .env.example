# ─────────────────────────────────────────────────────────────────
# MI-RA Studio — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_ENV=development
APP_NAME="MI-RA Studio"
APP_VERSION=1.0.0
DEBUG=true

# ── Backend ──────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Supabase Postgres) ───────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
# Use Session/direct URL (port 5432) for migrations:
DATABASE_URL_MIGRATE=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require
# Use Transaction pooler URL (port 6543) for the running API (recommended):
DATABASE_URL=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# ── Redis (local native — install Redis/Memurai on your machine) ───
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ── Object Storage ─────────────────────────────────────────────────
# local = ./data folder (default, no Docker/MinIO needed)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data
STORAGE_BASE_URL=http://localhost:8000/api/v1/media

# Optional: Supabase Storage instead of local disk
# STORAGE_BACKEND=supabase
# SUPABASE_STORAGE_BUCKET=mira-studio

# Optional: MinIO (only if you still run MinIO separately)
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=change_me
# MINIO_BUCKET=mira-studio
# MINIO_SECURE=false

# ── JWT Auth ─────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── GPU / AI ─────────────────────────────────────────────────────
GPU_ENABLED=false
CUDA_VISIBLE_DEVICES=0

# ── Feature Flags ────────────────────────────────────────────────
ENABLE_AI_PRELABELING=true
ENABLE_ACTIVE_LEARNING=false
ENABLE_GEOSPATIAL=true
