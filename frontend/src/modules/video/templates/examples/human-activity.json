{
  "template": {
    "name": "Human Activity",
    "version": "1.0",
    "description": "Example: people plus walk / run / sit temporal actions.",
    "status": "draft"
  },
  "tools": {
    "bounding_box": { "enabled": true, "visible": true, "hotkey": "B" },
