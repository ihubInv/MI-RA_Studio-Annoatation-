    { "id": "run", "name": "Run", "color": "#ef4444", "type": "temporal" },
    { "id": "sit", "name": "Sit", "color": "#0d559e", "type": "temporal" }
  ],
  "timeline": { "object_tracks": true, "action_tracks": true },
  "ai": { "enabled": true, "detect": true, "track": true },
  "export": { "formats": ["json", "srt"], "default_format": "json" }
