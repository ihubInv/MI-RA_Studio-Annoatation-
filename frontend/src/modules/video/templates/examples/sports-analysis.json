{
  "template": {
    "name": "Sports Analysis",
    "version": "1.0",
    "description": "Example: players, ball, actions, and marking relationships.",
    "status": "draft"
  },
  "tools": {
    "bounding_box": { "enabled": true, "visible": true, "hotkey": "B" },
    "point": { "enabled": true, "visible": true, "hotkey": "I" },
    "action": { "enabled": true, "visible": true },
    "relationship": { "enabled": true, "visible": true },
    "tracking": { "enabled": true, "visible": true }
  },
  "labels": [
    { "id": "player", "name": "Player", "color": "#fc6900", "type": "object", "allowed_tools": ["bounding_box"] },
    { "id": "ball", "name": "Ball", "color": "#eab308", "type": "object", "allowed_tools": ["bounding_box", "point"] }
  ],
  "actions": [
    { "id": "pass", "name": "Pass", "color": "#22c55e", "type": "instant" },
    { "id": "shot", "name": "Shot", "color": "#ef4444", "type": "instant" }
  ],
  "relations": [
    { "id": "marking", "name": "Marking", "color": "#a855f7", "source_label": "player", "target_label": "player", "directional": true }
  ],
  "timeline": { "object_tracks": true, "action_tracks": true, "trajectory_tracks": true },
  "ai": { "enabled": true, "detect": true, "track": true },
  "export": { "formats": ["json", "mot"], "default_format": "json" }
}
